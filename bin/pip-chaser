#!/usr/bin/env python3
"""Pip Chaser local CLI.

This CLI is intentionally small and dependency-free. It currently supports
read-only OANDA practice candle collection for detection workflows.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid


SUPPORTED_SYMBOLS = ("EUR_USD", "GBP_USD", "USD_JPY", "XAU_USD")
TIMEFRAME_TO_OANDA = {
    "15m": "M15",
    "1h": "H1",
    "4h": "H4",
    "Daily": "D",
}
DEFAULT_OANDA_PRACTICE_URL = "https://api-fxpractice.oanda.com"
DEFAULT_JOURNAL_DIR = "journal"
DEFAULT_SCAN_SYMBOLS = ("XAU_USD", "EUR_USD", "GBP_USD", "USD_JPY")
DEFAULT_SCAN_TIMEFRAMES = ("15m", "1h")
DEFAULT_ALERT_COOLDOWN_MINUTES = 240
DEFAULT_MAX_ALERTS_PER_SCAN = 1


class CliError(Exception):
    """User-facing CLI error."""


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def normalize_oanda_time(value: str) -> str:
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = dt.datetime.fromisoformat(value)
    return parsed.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_utc_datetime(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"
        return dt.datetime.fromisoformat(value).astimezone(dt.timezone.utc)
    except ValueError:
        return None


def require_symbol(symbol: str) -> str:
    symbol = symbol.upper()
    if symbol not in SUPPORTED_SYMBOLS:
        raise CliError(f"Unsupported symbol: {symbol}. Supported: {', '.join(SUPPORTED_SYMBOLS)}")
    return symbol


def require_timeframe(timeframe: str) -> str:
    if timeframe not in TIMEFRAME_TO_OANDA:
        raise CliError(f"Unsupported timeframe: {timeframe}. Supported: {', '.join(TIMEFRAME_TO_OANDA)}")
    return timeframe


def env_token() -> str:
    token = os.environ.get("OANDA_PAPER_API_KEY") or os.environ.get("OANDA_DEMO_API_KEY")
    if not token:
        raise CliError(
            "Missing OANDA practice token. Set OANDA_PAPER_API_KEY in the environment. "
            "Do not commit the token."
        )
    return token


def oanda_base_url() -> str:
    return os.environ.get("OANDA_PAPER_API_BASE", DEFAULT_OANDA_PRACTICE_URL).rstrip("/")


def telegram_config(dry_run: bool) -> tuple[str | None, str | None]:
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat_id = os.environ.get("TELEGRAM_SIGNAL_CHAT_ID")
    if not dry_run and (not token or not chat_id):
        raise CliError(
            "Missing Telegram delivery config. Set TELEGRAM_BOT_TOKEN and TELEGRAM_SIGNAL_CHAT_ID, "
            "or use --dry-run."
        )
    return token, chat_id


def authorized_alert_user_ids() -> set[str]:
    raw = os.environ.get("PIP_CHASER_ALERT_ALLOWED_TELEGRAM_IDS", "")
    return {value.strip() for value in raw.split(",") if value.strip()}


def require_alert_authorization(user_id: str | None) -> str:
    if not user_id:
        raise CliError("Missing requester Telegram user ID. Refusing to start alert delivery.")
    allowed = authorized_alert_user_ids()
    if not allowed:
        raise CliError("Missing PIP_CHASER_ALERT_ALLOWED_TELEGRAM_IDS. Refusing to start alert delivery.")
    if str(user_id) not in allowed:
        raise CliError("This Telegram user is not allowed to start Pip Chaser alerts.")
    return str(user_id)


def read_json_stdin() -> dict:
    try:
        return json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        raise CliError(f"Invalid JSON on stdin: {exc}") from exc


def write_json(payload: dict) -> int:
    json.dump(payload, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


def journal_dir() -> Path:
    return Path(os.environ.get("PIP_CHASER_JOURNAL_DIR", DEFAULT_JOURNAL_DIR))


def journal_path(date_text: str | None = None, path_override: str | None = None) -> Path:
    if path_override:
        return Path(path_override)
    date_text = date_text or utc_now()[:10]
    return journal_dir() / f"{date_text}.jsonl"


def append_journal_entry(entry: dict, date_text: str | None = None, path_override: str | None = None) -> Path:
    path = journal_path(date_text, path_override)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")
    return path


def iter_journal_entries(date_text: str | None = None, path_override: str | None = None) -> list[dict]:
    path = journal_path(date_text, path_override)
    if not path.exists():
        return []

    entries = []
    with path.open("r", encoding="utf-8") as handle:
        for line_number, line in enumerate(handle, start=1):
            if not line.strip():
                continue
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError as exc:
                raise CliError(f"Invalid journal JSON on {path}:{line_number}: {exc}") from exc
    return entries


def build_journal_entry(event_type: str, payload: dict, status: str = "ok") -> dict:
    return {
        "journal_entry_id": str(uuid.uuid4()),
        "recorded_at": utc_now(),
        "event_type": event_type,
        "status": status,
        "workflow_run_id": payload.get("workflow_run_id"),
        "symbol": payload.get("symbol"),
        "timeframe": payload.get("timeframe"),
        "classification": payload.get("classification"),
        "direction": payload.get("direction"),
        "valid_detection": payload.get("valid_detection"),
        "payload": payload,
    }


def parse_csv_values(value: str | None, default: tuple[str, ...]) -> list[str]:
    if not value:
        return list(default)
    return [item.strip() for item in value.split(",") if item.strip()]


def detection_duplicate_key(result: dict) -> str | None:
    if result.get("direction") not in ("bullish", "bearish"):
        return None
    center = result.get("center_candle_timestamp")
    if not center:
        return None
    return "|".join(
        [
            str(result.get("symbol")),
            str(result.get("timeframe")),
            str(result.get("direction")),
            str(center),
        ]
    )


def alert_fingerprint(result: dict) -> str | None:
    if result.get("direction") not in ("bullish", "bearish"):
        return None
    return "|".join(
        [
            str(result.get("symbol")),
            str(result.get("timeframe")),
            str(result.get("direction")),
        ]
    )


def previous_detection_keys(date_text: str | None, path_override: str | None) -> set[str]:
    keys = set()
    for entry in iter_journal_entries(date_text, path_override):
        if entry.get("event_type") != "setup_decision":
            continue
        key = detection_duplicate_key(entry.get("payload") or {})
        if key:
            keys.add(key)
    return keys


def recent_alert_fingerprints(date_text: str | None, path_override: str | None, cooldown_minutes: int) -> set[str]:
    if cooldown_minutes <= 0:
        return set()
    cutoff = dt.datetime.now(dt.timezone.utc) - dt.timedelta(minutes=cooldown_minutes)
    fingerprints = set()
    for entry in iter_journal_entries(date_text, path_override):
        if entry.get("event_type") != "telegram_delivery":
            continue
        payload = entry.get("payload") or {}
        if payload.get("delivery_status") != "sent":
            continue
        recorded_at = parse_utc_datetime(str(entry.get("recorded_at") or ""))
        if not recorded_at or recorded_at < cutoff:
            continue
        fingerprint = alert_fingerprint(payload)
        if fingerprint:
            fingerprints.add(fingerprint)
    return fingerprints


def build_telegram_signal_message(result: dict) -> str:
    direction = str(result.get("direction", "unknown")).title()
    confidence = str(result.get("classification", "unknown")).title()
    current_price = result.get("current_price")
    price_line = f"Current OANDA price: {current_price}\n" if current_price is not None else ""
    return (
        "Pip Chaser Signal\n\n"
        f"Pair: {result.get('symbol', 'unknown')}\n"
        f"Timeframe: {result.get('timeframe', 'unknown')}\n"
        f"{price_line}"
        f"Direction: {direction}\n"
        f"Confidence: {confidence}\n\n"
        f"Why:\n{result.get('reasoning_summary', 'No reasoning summary available.')}\n\n"
        f"Confirmation:\n{result.get('confirmation_notes', 'No confirmation notes available.')}\n\n"
        "Note: Detection only. No trade has been placed."
    )


def send_telegram_message(token: str, chat_id: str, text: str) -> dict:
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    body = urllib.parse.urlencode(
        {
            "chat_id": chat_id,
            "text": text,
            "disable_web_page_preview": "true",
        }
    ).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise CliError(f"Telegram send failed with HTTP {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise CliError(f"Telegram send failed: {exc.reason}") from exc

    if not payload.get("ok"):
        raise CliError(f"Telegram send failed: {payload}")
    return payload


def build_delivery_record(result: dict, status: str, reason: str, message_id: int | None = None) -> dict:
    return {
        "workflow_run_id": result.get("workflow_run_id"),
        "symbol": result.get("symbol"),
        "timeframe": result.get("timeframe"),
        "classification": result.get("classification"),
        "direction": result.get("direction"),
        "valid_detection": result.get("valid_detection"),
        "duplicate_alert": result.get("duplicate_alert"),
        "delivery_status": status,
        "delivery_reason": reason,
        "telegram_message_id": message_id,
    }


def request_oanda_candles(symbol: str, timeframe: str, count: int) -> dict:
    query = urllib.parse.urlencode(
        {
            "price": "M",
            "granularity": TIMEFRAME_TO_OANDA[timeframe],
            "count": str(count),
        }
    )
    url = f"{oanda_base_url()}/v3/instruments/{symbol}/candles?{query}"
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {env_token()}",
            "Content-Type": "application/json",
            "Accept-Datetime-Format": "RFC3339",
        },
    )

    for attempt in range(1, 4):
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")
            if attempt < 3 and (exc.code == 429 or exc.code >= 500):
                time.sleep(attempt)
                continue
            raise CliError(f"OANDA candle request failed with HTTP {exc.code}: {detail}") from exc
        except urllib.error.URLError as exc:
            if attempt < 3:
                time.sleep(attempt)
                continue
            raise CliError(f"OANDA candle request failed: {exc.reason}") from exc

    raise CliError("OANDA candle request failed after retries")


def request_oanda_price(symbol: str) -> dict:
    query = urllib.parse.urlencode({"price": "M", "granularity": "M1", "count": "2"})
    url = f"{oanda_base_url()}/v3/instruments/{symbol}/candles?{query}"
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {env_token()}",
            "Content-Type": "application/json",
            "Accept-Datetime-Format": "RFC3339",
        },
    )

    payload = None
    for attempt in range(1, 4):
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                payload = json.loads(response.read().decode("utf-8"))
                break
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")
            if attempt < 3 and (exc.code == 429 or exc.code >= 500):
                time.sleep(attempt)
                continue
            raise CliError(f"OANDA price request failed with HTTP {exc.code}: {detail}") from exc
        except urllib.error.URLError as exc:
            if attempt < 3:
                time.sleep(attempt)
                continue
            raise CliError(f"OANDA price request failed: {exc.reason}") from exc

    if payload is None:
        raise CliError("OANDA price request failed after retries")

    closed = [candle for candle in payload.get("candles", []) if candle.get("complete") is True]
    if not closed:
        raise CliError("OANDA price request returned no closed candles")
    candle = closed[-1]
    mid = candle.get("mid") or {}
    return {
        "symbol": symbol,
        "source": "oanda_practice_candles",
        "mode": "paper_data",
        "retrieved_at": utc_now(),
        "timestamp": normalize_oanda_time(candle["time"]),
        "price": float(mid["c"]),
        "open": float(mid["o"]),
        "high": float(mid["h"]),
        "low": float(mid["l"]),
        "close": float(mid["c"]),
        "complete": bool(candle.get("complete")),
    }


def price_decimals(symbol: str) -> int:
    if symbol == "XAU_USD":
        return 3
    return 3 if "JPY" in symbol else 5


def round_price(symbol: str, price: float) -> float:
    return round(price, price_decimals(symbol))


def average_range(candles: list[dict]) -> float:
    ranges = [candle_value(candle, "high") - candle_value(candle, "low") for candle in candles]
    return sum(ranges) / len(ranges) if ranges else 0.0


def latest_closed_price(candles: list[dict], symbol: str) -> float | None:
    complete_candles = [candle for candle in candles if candle.get("complete") is True]
    if not complete_candles:
        return None
    return round_price(symbol, candle_value(complete_candles[-1], "close"))


def ema_series(values: list[float], period: int) -> list[float]:
    if not values:
        return []
    multiplier = 2 / (period + 1)
    ema_values = [values[0]]
    for value in values[1:]:
        ema_values.append((value - ema_values[-1]) * multiplier + ema_values[-1])
    return ema_values


def rsi_value(values: list[float], period: int = 14) -> float | None:
    if len(values) <= period:
        return None
    gains = []
    losses = []
    for index in range(1, period + 1):
        change = values[index] - values[index - 1]
        gains.append(max(change, 0.0))
        losses.append(abs(min(change, 0.0)))

    average_gain = sum(gains) / period
    average_loss = sum(losses) / period
    for index in range(period + 1, len(values)):
        change = values[index] - values[index - 1]
        gain = max(change, 0.0)
        loss = abs(min(change, 0.0))
        average_gain = ((average_gain * (period - 1)) + gain) / period
        average_loss = ((average_loss * (period - 1)) + loss) / period

    if average_loss == 0:
        return 100.0
    relative_strength = average_gain / average_loss
    return 100 - (100 / (1 + relative_strength))


def macd_values(values: list[float]) -> tuple[float | None, float | None, float | None]:
    if len(values) < 35:
        return None, None, None
    ema12 = ema_series(values, 12)
    ema26 = ema_series(values, 26)
    macd_line = [fast - slow for fast, slow in zip(ema12, ema26)]
    signal_line = ema_series(macd_line, 9)
    if not signal_line:
        return None, None, None
    histogram = macd_line[-1] - signal_line[-1]
    return macd_line[-1], signal_line[-1], histogram


def build_trend_and_indicator_context(candles: list[dict], symbol: str) -> tuple[dict, dict]:
    complete_candles = [candle for candle in candles if candle.get("complete") is True]
    candidate = find_recent_fractal_candidate(complete_candles)
    closes = [candle_value(candle, "close") for candle in complete_candles]
    if len(closes) < 50 or not candidate:
        return (
            {
                "direction": "unknown",
                "moving_average_confirmation": "missing",
                "notes": "Need at least 50 closed candles and a recent fractal candidate for EMA 20/50 confirmation.",
            },
            {
                "rsi_confirmation": "missing",
                "macd_confirmation": "missing",
                "rsi": None,
                "macd": None,
                "macd_signal": None,
                "macd_histogram": None,
                "notes": "Need enough closed candles and a recent fractal candidate for RSI 14 and MACD 12/26/9 confirmation.",
            },
        )

    direction, _window = candidate
    ema20 = ema_series(closes, 20)[-1]
    ema50 = ema_series(closes, 50)[-1]
    latest_close = closes[-1]
    trend_direction = "up" if ema20 > ema50 else "down" if ema20 < ema50 else "sideways"
    bullish_ma = trend_direction == "up" and latest_close >= ema20
    bearish_ma = trend_direction == "down" and latest_close <= ema20
    ma_aligned = bullish_ma if direction == "bullish" else bearish_ma

    rsi = rsi_value(closes, 14)
    macd_line, macd_signal, macd_histogram = macd_values(closes)
    bullish_rsi = rsi is not None and 50 <= rsi <= 70
    bearish_rsi = rsi is not None and 30 <= rsi <= 50
    bullish_macd = macd_line is not None and macd_signal is not None and macd_line > macd_signal
    bearish_macd = macd_line is not None and macd_signal is not None and macd_line < macd_signal
    rsi_aligned = bullish_rsi if direction == "bullish" else bearish_rsi
    macd_aligned = bullish_macd if direction == "bullish" else bearish_macd

    trend_context = {
        "direction": trend_direction,
        "moving_average_confirmation": "aligned" if ma_aligned else "conflicting",
        "ema_20": round_price(symbol, ema20),
        "ema_50": round_price(symbol, ema50),
        "notes": (
            f"EMA 20/50 trend is {trend_direction}; "
            f"{direction} fractal MA confirmation is {'aligned' if ma_aligned else 'conflicting'}."
        ),
    }
    indicator_context = {
        "rsi_confirmation": "aligned" if rsi_aligned else "conflicting",
        "macd_confirmation": "aligned" if macd_aligned else "conflicting",
        "rsi": round(rsi, 2) if rsi is not None else None,
        "macd": round_price(symbol, macd_line) if macd_line is not None else None,
        "macd_signal": round_price(symbol, macd_signal) if macd_signal is not None else None,
        "macd_histogram": round_price(symbol, macd_histogram) if macd_histogram is not None else None,
        "notes": (
            f"RSI 14 is {round(rsi, 2) if rsi is not None else 'missing'}; "
            f"MACD 12/26/9 confirmation is {'aligned' if macd_aligned else 'conflicting'}."
        ),
    }
    return trend_context, indicator_context


def find_recent_fractal_candidate(candles: list[dict]) -> tuple[str, list[dict]] | None:
    candidate = None
    for start in range(0, len(candles) - 4):
        window = candles[start : start + 5]
        if is_bullish_fractal(window):
            candidate = ("bullish", window)
        elif is_bearish_fractal(window):
            candidate = ("bearish", window)
    return candidate


def pivot_levels(candles: list[dict], key: str) -> list[float]:
    levels = []
    for index in range(1, len(candles) - 1):
        current = candle_value(candles[index], key)
        previous_value = candle_value(candles[index - 1], key)
        next_value = candle_value(candles[index + 1], key)
        if key == "low" and current < previous_value and current < next_value:
            levels.append(current)
        if key == "high" and current > previous_value and current > next_value:
            levels.append(current)
    return levels


def nearest_level(price: float, levels: list[float]) -> float | None:
    if not levels:
        return None
    return min(levels, key=lambda level: abs(price - level))


def build_support_resistance_context(candles: list[dict], symbol: str) -> dict:
    complete_candles = [candle for candle in candles if candle.get("complete") is True]
    candidate = find_recent_fractal_candidate(complete_candles)
    if len(complete_candles) < 21 or not candidate:
        return {
            "near_support": None,
            "near_resistance": None,
            "nearest_support": None,
            "nearest_resistance": None,
            "distance_to_support": None,
            "distance_to_resistance": None,
            "tolerance": None,
            "method": "recent_swing_pivots",
            "notes": "Not enough closed candles or no recent fractal candidate for automatic support/resistance context.",
        }

    direction, window = candidate
    center = window[2]
    candidate_price = candle_value(center, "low" if direction == "bullish" else "high")
    recent = complete_candles[-50:]
    support_levels = pivot_levels(recent, "low")
    resistance_levels = pivot_levels(recent, "high")
    nearest_support = nearest_level(candidate_price, support_levels)
    nearest_resistance = nearest_level(candidate_price, resistance_levels)
    avg_range = average_range(recent[-20:])
    tolerance = avg_range * 0.5 if avg_range else 0.0
    distance_to_support = abs(candidate_price - nearest_support) if nearest_support is not None else None
    distance_to_resistance = abs(candidate_price - nearest_resistance) if nearest_resistance is not None else None
    near_support = distance_to_support is not None and distance_to_support <= tolerance
    near_resistance = distance_to_resistance is not None and distance_to_resistance <= tolerance
    relevant_near = near_support if direction == "bullish" else near_resistance
    relevant_label = "support" if direction == "bullish" else "resistance"

    if relevant_near:
        notes = f"Recent {direction} fractal is near computed {relevant_label} using swing pivots from closed candles."
    else:
        notes = f"Recent {direction} fractal is not close enough to computed {relevant_label} using swing pivots from closed candles."

    return {
        "near_support": near_support,
        "near_resistance": near_resistance,
        "nearest_support": round_price(symbol, nearest_support) if nearest_support is not None else None,
        "nearest_resistance": round_price(symbol, nearest_resistance) if nearest_resistance is not None else None,
        "distance_to_support": round_price(symbol, distance_to_support) if distance_to_support is not None else None,
        "distance_to_resistance": round_price(symbol, distance_to_resistance) if distance_to_resistance is not None else None,
        "tolerance": round_price(symbol, tolerance),
        "method": "recent_swing_pivots",
        "notes": notes,
    }


def normalize_market_context(
    payload: dict,
    symbol: str,
    timeframe: str,
    requested_by: dict,
    workflow_run_id: str,
) -> dict:
    candles = []
    for candle in payload.get("candles", []):
        mid = candle.get("mid") or {}
        candles.append(
            {
                "timestamp": normalize_oanda_time(candle["time"]),
                "open": float(mid["o"]),
                "high": float(mid["h"]),
                "low": float(mid["l"]),
                "close": float(mid["c"]),
                "volume": candle.get("volume"),
                "complete": bool(candle.get("complete")),
            }
        )

    trend_context, indicator_context = build_trend_and_indicator_context(candles, symbol)

    return {
        "workflow_run_id": workflow_run_id,
        "symbol": symbol,
        "timeframe": timeframe,
        "current_price": latest_closed_price(candles, symbol),
        "source": {
            "name": "oanda_candles",
            "mode": "paper_data",
            "retrieved_at": utc_now(),
        },
        "requested_by": requested_by,
        "candles": candles,
        "support_resistance_context": build_support_resistance_context(candles, symbol),
        "trend_context": trend_context,
        "indicator_context": indicator_context,
    }


def cmd_collect(args: argparse.Namespace) -> int:
    symbol = require_symbol(args.symbol)
    timeframe = require_timeframe(args.timeframe)
    if args.count < 5 or args.count > 5000:
        raise CliError("count must be between 5 and 5000")

    payload = request_oanda_candles(symbol=symbol, timeframe=timeframe, count=args.count)
    requested_by = {
        "channel": args.channel,
        "user_id": args.user_id,
    }
    if args.chat_id:
        requested_by["chat_id"] = args.chat_id
    if args.message_id:
        requested_by["message_id"] = args.message_id

    context = normalize_market_context(
        payload=payload,
        symbol=symbol,
        timeframe=timeframe,
        requested_by=requested_by,
        workflow_run_id=args.workflow_run_id or str(uuid.uuid4()),
    )
    return write_json(context)


def cmd_price(args: argparse.Namespace) -> int:
    symbol = require_symbol(args.symbol)
    return write_json(request_oanda_price(symbol))


def required_fields_for_schema(schema_path: str) -> tuple[str, ...]:
    schema_name = Path(schema_path).name
    if schema_name == "market-context.schema.json":
        return ("workflow_run_id", "symbol", "timeframe", "candles", "source", "requested_by")
    if schema_name == "detection-result.schema.json":
        return (
            "workflow_run_id",
            "valid_detection",
            "direction",
            "timeframe",
            "reasoning_summary",
            "confirmation_notes",
            "telegram_notification_draft",
            "missing_information",
        )
    raise CliError(f"Unsupported schema: {schema_path}")


def validate_basic_schema(payload: dict, schema_path: str) -> None:
    if not isinstance(payload, dict):
        raise CliError("Expected a JSON object")

    missing = [field for field in required_fields_for_schema(schema_path) if field not in payload]
    if missing:
        raise CliError(f"Schema validation failed; missing required fields: {', '.join(missing)}")

    if Path(schema_path).name == "market-context.schema.json":
        require_symbol(str(payload["symbol"]))
        require_timeframe(str(payload["timeframe"]))
        candles = payload.get("candles")
        if not isinstance(candles, list) or len(candles) < 5:
            raise CliError("Schema validation failed; candles must contain at least 5 items")
        for index, candle in enumerate(candles):
            for field in ("timestamp", "open", "high", "low", "close", "complete"):
                if field not in candle:
                    raise CliError(f"Schema validation failed; candle {index} missing {field}")

    if Path(schema_path).name == "detection-result.schema.json":
        if payload["direction"] not in ("bullish", "bearish", "none"):
            raise CliError("Schema validation failed; direction must be bullish, bearish, or none")
        if payload["timeframe"] not in ("15m", "1h", "4h", "Daily", "unknown"):
            raise CliError("Schema validation failed; unsupported timeframe")


def validate_market_context_core(payload: dict) -> None:
    if not isinstance(payload, dict):
        raise CliError("Expected a JSON object")
    for field in ("workflow_run_id", "symbol", "timeframe", "candles", "source", "requested_by"):
        if field not in payload:
            raise CliError(f"Market context missing required field: {field}")
    require_symbol(str(payload["symbol"]))
    require_timeframe(str(payload["timeframe"]))
    if not isinstance(payload["candles"], list):
        raise CliError("Market context candles must be a list")


def cmd_schema_validate(args: argparse.Namespace) -> int:
    payload = read_json_stdin()
    validate_basic_schema(payload, args.schema)
    return write_json(payload)


def candle_value(candle: dict, key: str) -> float:
    try:
        return float(candle[key])
    except (KeyError, TypeError, ValueError) as exc:
        raise CliError(f"Invalid candle {key} value") from exc


def is_bullish_fractal(window: list[dict]) -> bool:
    center_low = candle_value(window[2], "low")
    return all(center_low < candle_value(candle, "low") for index, candle in enumerate(window) if index != 2)


def is_bearish_fractal(window: list[dict]) -> bool:
    center_high = candle_value(window[2], "high")
    return all(center_high > candle_value(candle, "high") for index, candle in enumerate(window) if index != 2)


def context_confirmation_state(context: dict, direction: str) -> tuple[str, list[str], list[str]]:
    missing = []
    conflicts = []

    support = context.get("support_resistance_context") or {}
    trend = context.get("trend_context") or {}
    indicators = context.get("indicator_context") or {}

    relevant_key = "near_support" if direction == "bullish" else "near_resistance"
    relevant_label = "support" if direction == "bullish" else "resistance"
    relevant_context = support.get(relevant_key)
    if relevant_context is None:
        missing.append("support/resistance context")
    elif relevant_context is False:
        conflicts.append(f"fractal is not near computed {relevant_label}")

    ma = trend.get("moving_average_confirmation", "missing")
    if ma in ("missing", "unknown"):
        missing.append("Moving Average confirmation")
    elif ma == "conflicting":
        conflicts.append("Moving Average confirmation conflicts")

    for label, key in (("RSI", "rsi_confirmation"), ("MACD", "macd_confirmation")):
        value = indicators.get(key, "missing")
        if value in ("missing", "unknown"):
            missing.append(f"{label} confirmation")
        elif value == "conflicting":
            conflicts.append(f"{label} confirmation conflicts")

    if conflicts:
        return "conflicting", missing, conflicts
    if missing:
        return "missing", missing, conflicts
    return "aligned", missing, conflicts


def build_detection_result(context: dict) -> dict:
    validate_market_context_core(context)

    complete_candles = [candle for candle in context["candles"] if candle.get("complete") is True]
    base = {
        "workflow_run_id": context["workflow_run_id"],
        "symbol": context.get("symbol"),
        "timeframe": context.get("timeframe", "unknown"),
        "current_price": context.get("current_price"),
        "center_candle_timestamp": None,
        "support_resistance_context": context.get("support_resistance_context"),
    }

    if len(complete_candles) < 5:
        return {
            **base,
            "valid_detection": False,
            "classification": "invalid",
            "direction": "none",
            "reasoning_summary": "Invalid setup: fewer than 5 closed candles are available.",
            "confirmation_notes": "A fractal requires five consecutive closed candles.",
            "telegram_notification_draft": "No fractal alert: fewer than 5 closed candles are available. Detection only; no trade has been placed.",
            "missing_information": ["at least 5 closed candles"],
        }

    candidate = None
    for start in range(0, len(complete_candles) - 4):
        window = complete_candles[start : start + 5]
        if is_bullish_fractal(window):
            candidate = ("bullish", window)
        elif is_bearish_fractal(window):
            candidate = ("bearish", window)

    if not candidate:
        return {
            **base,
            "valid_detection": False,
            "classification": "invalid",
            "direction": "none",
            "reasoning_summary": "Invalid setup: no complete 5-candle bullish or bearish fractal was found.",
            "confirmation_notes": "The middle candle was not the strict high or low extreme in any complete 5-candle window.",
            "telegram_notification_draft": "No fractal alert: no valid 5-candle fractal was found. Detection only; no trade has been placed.",
            "missing_information": [],
        }

    direction, window = candidate
    center = window[2]
    confirmation_state, missing, conflicts = context_confirmation_state(context, direction)
    classification = "valid" if confirmation_state == "aligned" else "weak"
    valid_detection = classification == "valid"
    if conflicts:
        confirmation_notes = "Conflicting confirmation: " + "; ".join(conflicts)
    elif missing:
        confirmation_notes = "Missing confirmation: " + "; ".join(missing)
    else:
        confirmation_notes = "Support/resistance, Moving Average, RSI, and MACD context are present and aligned."

    reason = (
        f"{classification.title()} {direction} fractal on {context['symbol']} {context['timeframe']}: "
        f"the center candle is the {'lowest low' if direction == 'bullish' else 'highest high'} "
        "within a complete 5-candle window."
    )
    alert = (
        f"Fractal detection\n\n"
        f"Symbol: {context['symbol']}\n"
        f"Timeframe: {context['timeframe']}\n"
        f"Direction: {direction}\n"
        f"Confidence: {classification}\n\n"
        f"Why: {reason}\n"
        f"Confirmation: {confirmation_notes}\n\n"
        "Note: detection only. No trade has been placed."
    )

    return {
        **base,
        "valid_detection": valid_detection,
        "classification": classification,
        "direction": direction,
        "center_candle_timestamp": center.get("timestamp"),
        "reasoning_summary": reason,
        "confirmation_notes": confirmation_notes,
        "telegram_notification_draft": alert,
        "missing_information": missing,
    }


def cmd_classify_fractal(args: argparse.Namespace) -> int:
    context = read_json_stdin()
    return write_json(build_detection_result(context))


def cmd_workflow_validate_setup(args: argparse.Namespace) -> int:
    context = read_json_stdin()
    result = build_detection_result(context)
    validate_basic_schema(result, "detection-result.schema.json")
    if args.journal:
        workflow_payload = {
            "workflow_run_id": result["workflow_run_id"],
            "symbol": result.get("symbol"),
            "timeframe": result.get("timeframe"),
            "workflow": "validate_setup",
        }
        append_journal_entry(
            build_journal_entry("workflow_run", workflow_payload),
            args.journal_date,
            args.journal_path,
        )
        append_journal_entry(
            build_journal_entry("setup_decision", result),
            args.journal_date,
            args.journal_path,
        )
    return write_json(result)


def cmd_workflow_market_scan(args: argparse.Namespace) -> int:
    symbols = [require_symbol(symbol) for symbol in parse_csv_values(args.symbols, DEFAULT_SCAN_SYMBOLS)]
    timeframes = [require_timeframe(timeframe) for timeframe in parse_csv_values(args.timeframes, DEFAULT_SCAN_TIMEFRAMES)]
    if args.count < 5 or args.count > 5000:
        raise CliError("count must be between 5 and 5000")
    if args.alert_cooldown_minutes < 0:
        raise CliError("alert cooldown must be zero or greater")
    if args.max_alerts < 0:
        raise CliError("max alerts must be zero or greater")
    if args.send_telegram and not args.journal:
        raise CliError("Telegram delivery requires --journal so signals and skips are auditable.")
    telegram_token = None
    telegram_chat_id = None
    if args.send_telegram:
        telegram_token, telegram_chat_id = telegram_config(args.dry_run)
    scan_run_id = args.workflow_run_id or str(uuid.uuid4())
    existing_keys = previous_detection_keys(args.journal_date, args.journal_path) if args.journal else set()
    recent_fingerprints = (
        recent_alert_fingerprints(args.journal_date, args.journal_path, args.alert_cooldown_minutes)
        if args.journal
        else set()
    )
    seen_keys = set(existing_keys)
    seen_fingerprints = set(recent_fingerprints)
    results = []
    failures = []
    delivery_results = []

    for symbol in symbols:
        for timeframe in timeframes:
            workflow_run_id = f"{scan_run_id}:{symbol}:{timeframe}"
            try:
                payload = request_oanda_candles(symbol=symbol, timeframe=timeframe, count=args.count)
                context = normalize_market_context(
                    payload=payload,
                    symbol=symbol,
                    timeframe=timeframe,
                    requested_by={
                        "channel": args.channel,
                        "user_id": args.user_id,
                    },
                    workflow_run_id=workflow_run_id,
                )
                result = build_detection_result(context)
                validate_basic_schema(result, "detection-result.schema.json")
                key = detection_duplicate_key(result)
                fingerprint = alert_fingerprint(result)
                duplicate_reasons = []
                if key and key in seen_keys:
                    duplicate_reasons.append("same_fractal")
                if fingerprint and fingerprint in seen_fingerprints:
                    duplicate_reasons.append("cooldown")
                result["duplicate_alert"] = bool(duplicate_reasons)
                result["duplicate_reason"] = ",".join(duplicate_reasons) if duplicate_reasons else None
                result["alert_cooldown_minutes"] = args.alert_cooldown_minutes
                if key:
                    seen_keys.add(key)
                if fingerprint:
                    seen_fingerprints.add(fingerprint)
                results.append(result)

                if args.journal:
                    append_journal_entry(
                        build_journal_entry(
                            "workflow_run",
                            {
                                "workflow_run_id": workflow_run_id,
                                "symbol": symbol,
                                "timeframe": timeframe,
                                "workflow": "market_scan",
                            },
                        ),
                        args.journal_date,
                        args.journal_path,
                    )
                    append_journal_entry(
                        build_journal_entry("setup_decision", result),
                        args.journal_date,
                        args.journal_path,
                    )
            except CliError as exc:
                failure = {
                    "workflow_run_id": workflow_run_id,
                    "symbol": symbol,
                    "timeframe": timeframe,
                    "error": str(exc),
                }
                failures.append(failure)
                if args.journal:
                    append_journal_entry(
                        build_journal_entry("failure", failure, status="failed"),
                        args.journal_date,
                        args.journal_path,
                    )

    counts = {
        "scanned": len(results),
        "valid": sum(1 for result in results if result.get("classification") == "valid"),
        "weak": sum(1 for result in results if result.get("classification") == "weak"),
        "invalid": sum(1 for result in results if result.get("classification") == "invalid"),
        "duplicate_alerts": sum(1 for result in results if result.get("duplicate_alert")),
        "failures": len(failures),
    }
    alert_candidates = [
        result
        for result in results
        if result.get("valid_detection") is True and result.get("duplicate_alert") is not True
    ]

    if args.send_telegram:
        sent_this_scan = 0
        for result in results:
            message_id = None
            if result.get("duplicate_alert"):
                reason = result.get("duplicate_reason") or "duplicate_alert"
                delivery = build_delivery_record(result, "skipped", reason)
            elif result.get("valid_detection") is not True:
                delivery = build_delivery_record(result, "skipped", f"{result.get('classification')}_detection")
            elif sent_this_scan >= args.max_alerts:
                delivery = build_delivery_record(result, "skipped", "alert_limit_reached")
            else:
                message = build_telegram_signal_message(result)
                if args.dry_run:
                    delivery = build_delivery_record(result, "dry_run", "message_not_sent")
                    delivery["telegram_message"] = message
                    sent_this_scan += 1
                else:
                    try:
                        telegram_response = send_telegram_message(str(telegram_token), str(telegram_chat_id), message)
                        message_id = telegram_response.get("result", {}).get("message_id")
                        delivery = build_delivery_record(result, "sent", "valid_detection", message_id)
                        sent_this_scan += 1
                    except CliError as exc:
                        delivery = build_delivery_record(result, "failed", str(exc))
            result["telegram_delivery"] = delivery
            delivery_results.append(delivery)
            if args.journal:
                append_journal_entry(
                    build_journal_entry(
                        "telegram_delivery",
                        delivery,
                        status="failed" if delivery["delivery_status"] == "failed" else "ok",
                    ),
                    args.journal_date,
                    args.journal_path,
                )

    delivered = sum(1 for delivery in delivery_results if delivery.get("delivery_status") == "sent")
    dry_run_deliveries = sum(1 for delivery in delivery_results if delivery.get("delivery_status") == "dry_run")
    skipped_deliveries = sum(1 for delivery in delivery_results if delivery.get("delivery_status") == "skipped")
    failed_deliveries = sum(1 for delivery in delivery_results if delivery.get("delivery_status") == "failed")
    counts["telegram_sent"] = delivered
    counts["telegram_dry_run"] = dry_run_deliveries
    counts["telegram_skipped"] = skipped_deliveries
    counts["telegram_failed"] = failed_deliveries

    summary_lines = [
        "Pip Chaser detection trial scan",
        f"Run: {scan_run_id}",
        f"Scanned: {counts['scanned']} setup(s)",
        f"Valid: {counts['valid']} | Weak: {counts['weak']} | Invalid: {counts['invalid']}",
        f"Duplicates: {counts['duplicate_alerts']} | Failures: {counts['failures']}",
        f"Telegram: sent {delivered} | dry-run {dry_run_deliveries} | skipped {skipped_deliveries} | failed {failed_deliveries}",
        f"Alert policy: max {args.max_alerts} per scan, {args.alert_cooldown_minutes} minute cooldown per pair/timeframe/direction",
        "Detection only. No trades were placed.",
    ]
    if alert_candidates:
        summary_lines.append(f"Alert candidates: {len(alert_candidates)}")
    else:
        summary_lines.append("Alert candidates: none")

    return write_json(
        {
            "workflow_run_id": scan_run_id,
            "scanned_at": utc_now(),
            "symbols": symbols,
            "timeframes": timeframes,
            "counts": counts,
            "results": results,
            "failures": failures,
            "alert_candidates": alert_candidates,
            "delivery_results": delivery_results,
            "telegram_summary_draft": "\n".join(summary_lines),
        }
    )


def cmd_alerts_run(args: argparse.Namespace) -> int:
    requester_id = require_alert_authorization(args.requested_by_telegram_id)
    scan_args = argparse.Namespace(
        symbols=args.symbols,
        timeframes=args.timeframes,
        count=args.count,
        workflow_run_id=args.workflow_run_id,
        channel="telegram",
        user_id=requester_id,
        journal=True,
        journal_date=args.journal_date,
        journal_path=args.journal_path,
        send_telegram=True,
        dry_run=args.dry_run,
        alert_cooldown_minutes=args.alert_cooldown_minutes,
        max_alerts=args.max_alerts,
    )
    return cmd_workflow_market_scan(scan_args)


def cmd_workflow_trade_explain(args: argparse.Namespace) -> int:
    result = read_json_stdin()
    validate_basic_schema(result, "detection-result.schema.json")
    return write_json(
        {
            "workflow_run_id": result.get("workflow_run_id"),
            "audience": args.audience,
            "telegram_message": result.get("telegram_notification_draft"),
            "safety_note": "Detection only. No trade has been placed.",
        }
    )


def cmd_workflow_daily_summary(args: argparse.Namespace) -> int:
    date_text = args.date or utc_now()[:10]
    summary = summarize_entries(iter_journal_entries(date_text, args.journal_path), date_text)
    summary["workflow"] = "daily_summary"
    return write_json(summary)


def cmd_journal_append(args: argparse.Namespace) -> int:
    payload = read_json_stdin()
    event_type = args.event_type
    if event_type == "auto":
        event_type = "setup_decision" if "classification" in payload else "workflow_run"
    entry = build_journal_entry(event_type, payload, args.status)
    path = append_journal_entry(entry, args.date, args.journal_path)
    return write_json({"journaled": True, "path": str(path), "journal_entry_id": entry["journal_entry_id"]})


def cmd_journal_list(args: argparse.Namespace) -> int:
    entries = iter_journal_entries(args.date, args.journal_path)
    if args.limit:
        entries = entries[-args.limit :]
    return write_json({"date": args.date or utc_now()[:10], "count": len(entries), "entries": entries})


def summarize_entries(entries: list[dict], date_text: str) -> dict:
    counts = {
        "total": len(entries),
        "valid": 0,
        "weak": 0,
        "invalid": 0,
        "failures": 0,
    }
    symbols: dict[str, int] = {}
    timeframes: dict[str, int] = {}
    latest = None

    for entry in entries:
        classification = entry.get("classification")
        if classification in ("valid", "weak", "invalid"):
            counts[classification] += 1
        if entry.get("status") != "ok":
            counts["failures"] += 1
        if entry.get("symbol"):
            symbols[entry["symbol"]] = symbols.get(entry["symbol"], 0) + 1
        if entry.get("timeframe"):
            timeframes[entry["timeframe"]] = timeframes.get(entry["timeframe"], 0) + 1
        latest = entry

    summary_lines = [
        f"Pip Chaser daily summary for {date_text}",
        f"Total journaled events: {counts['total']}",
        f"Valid detections: {counts['valid']}",
        f"Weak detections: {counts['weak']}",
        f"Invalid detections: {counts['invalid']}",
        f"Failures: {counts['failures']}",
    ]
    if latest:
        summary_lines.append(
            f"Latest: {latest.get('symbol', 'unknown')} {latest.get('timeframe', 'unknown')} "
            f"{latest.get('classification', latest.get('event_type', 'event'))}"
        )

    return {
        "date": date_text,
        "counts": counts,
        "symbols": symbols,
        "timeframes": timeframes,
        "telegram_summary_draft": "\n".join(summary_lines),
    }


def cmd_journal_summary(args: argparse.Namespace) -> int:
    date_text = args.date or utc_now()[:10]
    return write_json(summarize_entries(iter_journal_entries(date_text, args.journal_path), date_text))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pip-chaser")
    subparsers = parser.add_subparsers(dest="command_path", required=True)

    market_context = subparsers.add_parser("market-context")
    market_context_sub = market_context.add_subparsers(dest="market_context_command", required=True)

    collect = market_context_sub.add_parser("collect")
    collect.add_argument("--symbol", required=True)
    collect.add_argument("--timeframe", required=True)
    collect.add_argument("--count", type=int, default=50)
    collect.add_argument("--workflow-run-id")
    collect.add_argument("--channel", default="manual_test", choices=("telegram", "scheduled", "manual_test"))
    collect.add_argument("--user-id", default="unknown")
    collect.add_argument("--chat-id")
    collect.add_argument("--message-id")
    collect.set_defaults(func=cmd_collect)

    price = market_context_sub.add_parser("price")
    price.add_argument("--symbol", required=True)
    price.set_defaults(func=cmd_price)

    schemas = subparsers.add_parser("schemas")
    schemas_sub = schemas.add_subparsers(dest="schemas_command", required=True)
    validate = schemas_sub.add_parser("validate")
    validate.add_argument("--schema", required=True)
    validate.set_defaults(func=cmd_schema_validate)

    strategy = subparsers.add_parser("strategy")
    strategy_sub = strategy.add_subparsers(dest="strategy_command", required=True)
    classify = strategy_sub.add_parser("classify-fractal")
    classify.set_defaults(func=cmd_classify_fractal)

    workflows = subparsers.add_parser("workflows")
    workflows_sub = workflows.add_subparsers(dest="workflows_command", required=True)
    market_scan = workflows_sub.add_parser("market-scan")
    market_scan.add_argument("--symbols")
    market_scan.add_argument("--timeframes")
    market_scan.add_argument("--count", type=int, default=80)
    market_scan.add_argument("--workflow-run-id")
    market_scan.add_argument("--channel", default="manual_test", choices=("telegram", "scheduled", "manual_test"))
    market_scan.add_argument("--user-id", default="unknown")
    market_scan.add_argument("--journal", action="store_true")
    market_scan.add_argument("--journal-date")
    market_scan.add_argument("--journal-path")
    market_scan.add_argument("--send-telegram", action="store_true")
    market_scan.add_argument("--dry-run", action="store_true")
    market_scan.add_argument("--alert-cooldown-minutes", type=int, default=DEFAULT_ALERT_COOLDOWN_MINUTES)
    market_scan.add_argument("--max-alerts", type=int, default=DEFAULT_MAX_ALERTS_PER_SCAN)
    market_scan.set_defaults(func=cmd_workflow_market_scan)

    alerts = subparsers.add_parser("alerts")
    alerts_sub = alerts.add_subparsers(dest="alerts_command", required=True)
    alerts_run = alerts_sub.add_parser("run")
    alerts_run.add_argument("--requested-by-telegram-id", required=True)
    alerts_run.add_argument("--symbols")
    alerts_run.add_argument("--timeframes")
    alerts_run.add_argument("--count", type=int, default=80)
    alerts_run.add_argument("--workflow-run-id")
    alerts_run.add_argument("--journal-date")
    alerts_run.add_argument("--journal-path")
    alerts_run.add_argument("--dry-run", action="store_true")
    alerts_run.add_argument("--alert-cooldown-minutes", type=int, default=DEFAULT_ALERT_COOLDOWN_MINUTES)
    alerts_run.add_argument("--max-alerts", type=int, default=DEFAULT_MAX_ALERTS_PER_SCAN)
    alerts_run.set_defaults(func=cmd_alerts_run)

    validate_setup = workflows_sub.add_parser("validate-setup")
    validate_setup.add_argument("--journal", action="store_true")
    validate_setup.add_argument("--journal-date")
    validate_setup.add_argument("--journal-path")
    validate_setup.set_defaults(func=cmd_workflow_validate_setup)

    trade_explain = workflows_sub.add_parser("trade-explain")
    trade_explain.add_argument("--audience", default="telegram_group", choices=("telegram_group", "telegram_dm", "journal"))
    trade_explain.set_defaults(func=cmd_workflow_trade_explain)

    daily_summary = workflows_sub.add_parser("daily-summary")
    daily_summary.add_argument("--date")
    daily_summary.add_argument("--journal-path")
    daily_summary.set_defaults(func=cmd_workflow_daily_summary)

    journal = subparsers.add_parser("journal")
    journal_sub = journal.add_subparsers(dest="journal_command", required=True)
    append = journal_sub.add_parser("append")
    append.add_argument("--event-type", default="auto")
    append.add_argument("--status", default="ok")
    append.add_argument("--date")
    append.add_argument("--journal-path")
    append.set_defaults(func=cmd_journal_append)

    list_entries = journal_sub.add_parser("list")
    list_entries.add_argument("--date")
    list_entries.add_argument("--limit", type=int)
    list_entries.add_argument("--journal-path")
    list_entries.set_defaults(func=cmd_journal_list)

    summary = journal_sub.add_parser("summary")
    summary.add_argument("--date")
    summary.add_argument("--journal-path")
    summary.set_defaults(func=cmd_journal_summary)

    summarize = journal_sub.add_parser("summarize")
    summarize.add_argument("--date")
    summarize.add_argument("--journal-path")
    summarize.set_defaults(func=cmd_journal_summary)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except CliError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
